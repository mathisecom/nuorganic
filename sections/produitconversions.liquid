<script>
(() => {
  const root = document.getElementById('PDP-{{ section.id }}');
  if (!root || root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';

  const currency = root.dataset.currency || 'EUR';
  const locale = document.documentElement.lang || 'fr-FR';

  const formatMoney = (cents) => {
    try {
      return new Intl.NumberFormat(locale, {
        style: 'currency',
        currency,
        minimumFractionDigits: 2
      }).format((Number(cents) || 0) / 100);
    } catch (e) {
      return ((Number(cents) || 0) / 100).toFixed(2) + ' ' + currency;
    }
  };

  // Galerie
  const mainImage = root.querySelector('.pdp-main-image');
  root.querySelectorAll('.pdp-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      root.querySelectorAll('.pdp-thumb').forEach((t) => t.classList.remove('is-active'));
      thumb.classList.add('is-active');
      if (mainImage && thumb.dataset.full) {
        mainImage.src = thumb.dataset.full;
        mainImage.srcset = '';
        mainImage.alt = thumb.dataset.alt || '';
      }
    });
  });

  // Bundles + prix
  const quantityInput = root.querySelector('.pdp-quantity-input');
  const atcPrice = root.querySelector('.pdp-atc-price');
  const variantSelect = root.querySelector('.pdp-variant-select');
  const bundleCards = [...root.querySelectorAll('.pdp-bundle-card')];

  const getVariantData = () => {
    if (variantSelect) {
      const option = variantSelect.options[variantSelect.selectedIndex];
      return {
        price: Number(option?.dataset.price || 0),
        compare: Number(option?.dataset.compare || 0)
      };
    }

    return {
      price: {{ current_price | default: 0 | json }},
      compare: {{ current_compare | default: 0 | json }}
    };
  };

  const refreshBundlePrices = () => {
    const variant = getVariantData();

    bundleCards.forEach((card) => {
      const qty = Number(card.dataset.qty || 1);
      const discount = Number(card.dataset.discount || 0);
      const regularFromPrice = variant.price * qty;
      const compareTotal = variant.compare > variant.price
        ? variant.compare * qty
        : regularFromPrice;
      const discounted = Math.round(regularFromPrice * (1 - discount / 100));
      const savings = Math.max(0, compareTotal - discounted);

      const priceEl = card.querySelector('.pdp-bundle-price');
      const compareEl = card.querySelector('.pdp-bundle-compare');
      const savingsEl = card.querySelector('.pdp-savings');

      if (priceEl) priceEl.textContent = formatMoney(discounted);

      if (compareEl) {
        if (compareTotal > discounted) {
          compareEl.textContent = formatMoney(compareTotal);
          compareEl.hidden = false;
        } else {
          compareEl.hidden = true;
        }
      }

      if (savingsEl && savings > 0) {
        savingsEl.textContent = 'Vous économisez ' + formatMoney(savings);
      }

      if (card.classList.contains('is-selected') && atcPrice) {
        atcPrice.textContent = formatMoney(discounted);
      }
    });
  };

  bundleCards.forEach((card) => {
    const radio = card.querySelector('input[type="radio"]');
    radio?.addEventListener('change', () => {
      bundleCards.forEach((c) => c.classList.remove('is-selected'));
      card.classList.add('is-selected');

      if (quantityInput) quantityInput.value = card.dataset.qty || '1';

      const variant = getVariantData();
      const qty = Number(card.dataset.qty || 1);
      const discount = Number(card.dataset.discount || 0);
      const discounted = Math.round(variant.price * qty * (1 - discount / 100));

      if (atcPrice) atcPrice.textContent = formatMoney(discounted);
    });
  });

  variantSelect?.addEventListener('change', refreshBundlePrices);
  refreshBundlePrices();

  // Accordéons
  root.querySelectorAll('.pdp-accordion-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const content = toggle.nextElementSibling;
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      if (content) content.hidden = open;
    });
  });

  // Témoignages
  root.querySelectorAll('.pdp-testimonial-slider').forEach((slider) => {
    const slides = [...slider.querySelectorAll('.pdp-testimonial')];
    const dots = [...slider.querySelectorAll('.pdp-dot')];
    const prev = slider.querySelector('.pdp-prev');
    const next = slider.querySelector('.pdp-next');
    if (!slides.length) return;

    let index = 0;

    const show = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
    show(0);
  });
})();
</script>

{% schema %}
