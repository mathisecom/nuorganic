{% liquid
  assign product_obj = section.settings.product
  if product_obj == blank
    assign product_obj = product
  endif

  if product_obj != blank
    assign current_variant = product_obj.selected_or_first_available_variant
    assign current_price = current_variant.price
    assign current_compare = current_variant.compare_at_price | default: 0

    assign bundle_2_regular = current_price | times: 2
    if current_compare > current_price
      assign bundle_2_compare = current_compare | times: 2
    else
      assign bundle_2_compare = bundle_2_regular
    endif
    assign bundle_2_discount_amount = bundle_2_regular | times: section.settings.bundle_2_discount | divided_by: 100
    assign bundle_2_price = bundle_2_regular | minus: bundle_2_discount_amount
    assign bundle_2_savings = bundle_2_compare | minus: bundle_2_price

    assign bundle_3_regular = current_price | times: 3
    if current_compare > current_price
      assign bundle_3_compare = current_compare | times: 3
    else
      assign bundle_3_compare = bundle_3_regular
    endif
    assign bundle_3_discount_amount = bundle_3_regular | times: section.settings.bundle_3_discount | divided_by: 100
    assign bundle_3_price = bundle_3_regular | minus: bundle_3_discount_amount
    assign bundle_3_savings = bundle_3_compare | minus: bundle_3_price

    assign product_discount = 0
    if current_compare > current_price
      assign product_discount = current_compare | minus: current_price | times: 100 | divided_by: current_compare
    endif
  endif
%}

<section
  id="PDP-{{ section.id }}"
  class="pdp-conversion"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-button-label="{{ section.settings.add_to_cart_text | escape }}"
  style="
    --pdp-bg: {{ section.settings.background_color }};
    --pdp-text: {{ section.settings.text_color }};
    --pdp-muted: {{ section.settings.muted_color }};
    --pdp-accent: {{ section.settings.accent_color }};
    --pdp-accent-soft: {{ section.settings.accent_soft_color }};
    --pdp-button: {{ section.settings.button_color }};
    --pdp-button-text: {{ section.settings.button_text_color }};
    --pdp-border: {{ section.settings.border_color }};
    --pdp-radius: {{ section.settings.card_radius }}px;
    --pdp-max: {{ section.settings.max_width }}px;
    --pdp-gap: {{ section.settings.desktop_gap }}px;
    --pdp-pad-y: {{ section.settings.padding_y }}px;
  "
>
  {% if product_obj == blank %}
    <div class="pdp-empty">
      <strong>Sélectionne un produit</strong>
      <p>Choisis un produit dans les réglages de cette section pour afficher la fiche.</p>
    </div>
  {% else %}
    <div class="pdp-shell">
      <div class="pdp-grid">
        <!-- COLONNE GAUCHE : MÉDIAS -->
        <div class="pdp-left">
          <div class="pdp-gallery">
            <div class="pdp-thumbs" aria-label="Miniatures produit">
              {% assign image_count = 0 %}
              {% for media in product_obj.media %}
                {% if media.media_type == 'image' and image_count < section.settings.max_thumbnails %}
                  {% assign image_count = image_count | plus: 1 %}
                  <button
                    type="button"
                    class="pdp-thumb{% if image_count == 1 %} is-active{% endif %}"
                    data-full="{{ media | image_url: width: 1400 }}"
                    data-alt="{{ media.alt | default: product_obj.title | escape }}"
                    aria-label="Afficher l’image {{ image_count }}"
                  >
                    {{
                      media
                      | image_url: width: 180
                      | image_tag:
                        loading: 'lazy',
                        widths: '70, 100, 140, 180',
                        sizes: '80px',
                        alt: media.alt
                    }}
                  </button>
                {% endif %}
              {% endfor %}

              {% if image_count == 0 and product_obj.featured_image %}
                <button
                  type="button"
                  class="pdp-thumb is-active"
                  data-full="{{ product_obj.featured_image | image_url: width: 1400 }}"
                  data-alt="{{ product_obj.featured_image.alt | default: product_obj.title | escape }}"
                >
                  {{
                    product_obj.featured_image
                    | image_url: width: 180
                    | image_tag: loading: 'lazy', alt: product_obj.featured_image.alt
                  }}
                </button>
              {% endif %}

              {% if section.settings.show_gallery_arrow %}
                <div class="pdp-gallery-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 36" fill="none">
                    <path d="M12 1v31M3 23l9 9 9-9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              {% endif %}
            </div>

            <div class="pdp-main-media">
              {% if product_obj.featured_image %}
                {{
                  product_obj.featured_image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'pdp-main-image',
                    loading: 'eager',
                    fetchpriority: 'high',
                    widths: '480, 720, 960, 1200, 1400',
                    sizes: '(min-width: 990px) 48vw, 80vw',
                    alt: product_obj.featured_image.alt
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'pdp-placeholder' }}
              {% endif %}

              {% if section.settings.show_discount_badge and product_discount > 0 %}
                <div class="pdp-discount-badge">
                  {{ product_discount }}% DE RÉDUCTION
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Témoignages desktop -->
          <div class="pdp-desktop-only pdp-testimonial-wrap">
            {% liquid
  assign testimonial_count = 0
  for block in section.blocks
    if block.type == 'testimonial'
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
%}

{% if testimonial_count > 0 %}
  <div class="pdp-testimonial-slider">
    <div class="pdp-testimonial-card">
      {% assign testimonial_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' %}
          <div
            class="pdp-testimonial{% if testimonial_index == 0 %} is-active{% endif %}"
            data-slide="{{ testimonial_index }}"
            {{ block.shopify_attributes }}
          >
            <div class="pdp-testimonial-head">
              <span class="pdp-testimonial-stars" aria-label="{{ block.settings.stars }} étoiles sur 5">
                {% for i in (1..5) %}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{% endfor %}
              </span>
              <strong>{{ block.settings.name }}</strong>
              {% if block.settings.verified_text != blank %}
                <span>·</span>
                <span class="pdp-verified">{{ block.settings.verified_text }}</span>
              {% endif %}
            </div>
            <p class="pdp-testimonial-text">{{ block.settings.text }}</p>
          </div>
          {% assign testimonial_index = testimonial_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>

    {% if testimonial_count > 1 %}
      <div class="pdp-slider-controls">
        <button type="button" class="pdp-slider-arrow pdp-prev" aria-label="Avis précédent">
          <svg viewBox="0 0 24 24" fill="none"><path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="pdp-dots">
          {% for i in (1..testimonial_count) %}
            <button type="button" class="pdp-dot{% if i == 1 %} is-active{% endif %}" aria-label="Afficher l’avis {{ i }}"></button>
          {% endfor %}
        </div>
        <button type="button" class="pdp-slider-arrow pdp-next" aria-label="Avis suivant">
          <svg viewBox="0 0 24 24" fill="none"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {% endif %}
  </div>
{% endif %}

          </div>

          <!-- Presse desktop -->
          <div class="pdp-desktop-only">
            {% liquid
  assign press_count = 0
  for block in section.blocks
    if block.type == 'press_logo'
      assign press_count = press_count | plus: 1
    endif
  endfor
%}

{% if press_count > 0 %}
  <div class="pdp-press">
    {% if section.settings.press_label != blank %}
      <span class="pdp-press-label">{{ section.settings.press_label }}</span>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == 'press_logo' %}
        <div class="pdp-press-logo" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 220
              | image_tag: loading: 'lazy', alt: block.settings.text
            }}
          {% else %}
            <span>{{ block.settings.text }}</span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

          </div>
        </div>

        <!-- COLONNE DROITE : ACHAT -->
        <div class="pdp-right">
          <div class="pdp-rating-row">
            <div class="pdp-rating">
              <span class="pdp-stars" aria-label="{{ section.settings.rating }} étoiles sur 5">★★★★★</span>
              <span class="pdp-rating-text">
                {{ section.settings.rating }} ({{ section.settings.review_count }} avis)
              </span>
            </div>
            {% if section.settings.show_stock %}
              <span class="pdp-stock">
                <span class="pdp-stock-dot">•</span>
                {{ section.settings.stock_text }}
              </span>
            {% endif %}
          </div>

          <h1 class="pdp-title">
            {% if section.settings.custom_title != blank %}
              {{ section.settings.custom_title }}
            {% else %}
              {{ product_obj.title }}
            {% endif %}
          </h1>

          <div class="pdp-trust-list">
            {% if section.settings.trust_1 != blank %}
              <div class="pdp-trust-item">
                <span class="pdp-trust-icon">
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.5-2.9 8.1-7 10-4.1-1.9-7-5.5-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.7"/><path d="m9.3 12 1.8 1.8 3.8-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span>{{ section.settings.trust_1 }}</span>
              </div>
            {% endif %}
            {% if section.settings.trust_2 != blank %}
              <div class="pdp-trust-item">
                <span class="pdp-trust-icon">
                  <svg viewBox="0 0 24 24" fill="none"><path d="M5 8h14l-1.2 11H6.2L5 8Z" stroke="currentColor" stroke-width="1.7"/><path d="M8 8c.4-3 2-4.5 4-4.5S15.6 5 16 8M8 13c2.5 1.5 5.5 1.5 8 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </span>
                <span>{{ section.settings.trust_2 }}</span>
              </div>
            {% endif %}
            {% if section.settings.trust_3 != blank %}
              <div class="pdp-trust-item">
                <span class="pdp-trust-icon">
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 20v-8M12 12C8 12 5 9.8 5 6c4 0 7 2.2 7 6ZM12 14c4 0 7-2.2 7-6-4 0-7 2.2-7 6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span>{{ section.settings.trust_3 }}</span>
              </div>
            {% endif %}
          </div>

          {% assign product_form_id = 'PDPForm-' | append: section.id %}
          {% form 'product', product_obj, id: product_form_id, class: 'pdp-form' %}
            {% unless product_obj.has_only_default_variant %}
              <div class="pdp-variant-field">
                <label for="PDPVariant-{{ section.id }}">{{ section.settings.variant_label }}</label>
                <select id="PDPVariant-{{ section.id }}" name="id" class="pdp-variant-select">
                  {% for variant in product_obj.variants %}
                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price }}"
                      data-compare="{{ variant.compare_at_price | default: 0 }}"
                      {% if variant.id == current_variant.id %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title }} — {{ variant.price | money }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% else %}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
            {% endunless %}

            <input class="pdp-quantity-input" type="hidden" name="quantity" value="1">

            <div class="pdp-bundle-title">
              <span></span>
              <strong>{{ section.settings.bundle_heading }}</strong>
              <span></span>
            </div>

            <div class="pdp-bundles">
              <!-- 1 -->
              <label class="pdp-bundle-card is-selected" data-qty="1" data-discount="0">
                <input type="radio" name="pdp_bundle_{{ section.id }}" value="1" checked>
                <span class="pdp-radio"></span>
                <span class="pdp-bundle-copy">
                  <strong>{{ section.settings.bundle_1_title }}</strong>
                  <small class="pdp-savings">
                    {% if current_compare > current_price %}
                      Vous économisez {{ current_compare | minus: current_price | money }}
                    {% elsif section.settings.bundle_1_subtitle != blank %}
                      {{ section.settings.bundle_1_subtitle }}
                    {% endif %}
                  </small>
                </span>
                <span class="pdp-bundle-prices">
                  <strong class="pdp-bundle-price">{{ current_price | money }}</strong>
                  {% if current_compare > current_price %}
                    <del class="pdp-bundle-compare">{{ current_compare | money }}</del>
                  {% endif %}
                </span>
              </label>

              <!-- 2 -->
              <label class="pdp-bundle-card" data-qty="2" data-discount="{{ section.settings.bundle_2_discount }}">
                <input type="radio" name="pdp_bundle_{{ section.id }}" value="2">
                <span class="pdp-radio"></span>
                <span class="pdp-bundle-copy">
                  <strong>{{ section.settings.bundle_2_title }}</strong>
                  <small class="pdp-savings">Vous économisez {{ bundle_2_savings | money }}</small>
                </span>
                <span class="pdp-bundle-prices">
                  <strong class="pdp-bundle-price">{{ bundle_2_price | money }}</strong>
                  <del class="pdp-bundle-compare">{{ bundle_2_compare | money }}</del>
                </span>
              </label>

              <!-- 3 -->
              <label class="pdp-bundle-card" data-qty="3" data-discount="{{ section.settings.bundle_3_discount }}">
                <input type="radio" name="pdp_bundle_{{ section.id }}" value="3">
                <span class="pdp-radio"></span>
                <span class="pdp-bundle-copy">
                  <strong>{{ section.settings.bundle_3_title }}</strong>
                  <small class="pdp-bundle-3-subtitle">{{ section.settings.bundle_3_subtitle }}</small>
                </span>
                <span class="pdp-bundle-prices">
                  {% if section.settings.bundle_3_badge != blank %}
                    <em class="pdp-best-badge">{{ section.settings.bundle_3_badge }}</em>
                  {% endif %}
                  <strong class="pdp-bundle-price">{{ bundle_3_price | money }}</strong>
                  <del class="pdp-bundle-compare">{{ bundle_3_compare | money }}</del>
                </span>
              </label>
            </div>

            {% if section.settings.shipping_text != blank %}
              <div class="pdp-shipping-line">
                <span class="pdp-check">✓</span>
                {{ section.settings.shipping_text }}
              </div>
            {% endif %}

            <button
              type="submit"
              name="add"
              class="pdp-atc"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span class="pdp-atc-label">
                {% if current_variant.available %}
                  {{ section.settings.add_to_cart_text }}
                {% else %}
                  {{ section.settings.sold_out_text }}
                {% endif %}
              </span>
              {% if section.settings.show_price_in_button and current_variant.available %}
                <span class="pdp-atc-separator">-</span>
                <span class="pdp-atc-price">{{ current_price | money }}</span>
              {% endif %}
            </button>

            {% if section.settings.micro_1 != blank or section.settings.micro_2 != blank or section.settings.micro_3 != blank %}
              <div class="pdp-micro-trust">
                {% if section.settings.micro_1 != blank %}<span>🚚 {{ section.settings.micro_1 }}</span>{% endif %}
                {% if section.settings.micro_2 != blank %}<span>◉ {{ section.settings.micro_2 }}</span>{% endif %}
                {% if section.settings.micro_3 != blank %}<span>✚ {{ section.settings.micro_3 }}</span>{% endif %}
              </div>
            {% endif %}
          {% endform %}

          <div class="pdp-benefits">
            {% for block in section.blocks %}
              {% if block.type == 'benefit' %}
                <div class="pdp-benefit" {{ block.shopify_attributes }}>
                  <span class="pdp-benefit-icon">
                    {% case block.settings.icon %}
                      {% when 'eye' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M2.5 12s3.5-5.5 9.5-5.5S21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.5"/><path d="M7 6 5.7 4.2M10 5.5 9.5 3.2M14 5.5l.5-2.3M17 6l1.3-1.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                      {% when 'lashes' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M3 13c2-4 5-6 9-6s7 2 9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="m5 10-2-2M8 8 7 5M12 7V4M16 8l1-3M19 10l2-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                      {% when 'growth' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 16c4-5 12-5 16 0" stroke="currentColor" stroke-width="1.5"/><path d="M7 14v-4M10 12V7M14 12V6M17 14v-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                      {% when 'wand' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M10 3h4v13h-4V3Z" stroke="currentColor" stroke-width="1.4"/><path d="M9 16h6v5H9v-5ZM8 5h8M8 8h8" stroke="currentColor" stroke-width="1.4"/></svg>
                      {% when 'bottle' %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M9 4h6v4l2 3v9H7v-9l2-3V4Z" stroke="currentColor" stroke-width="1.5"/><path d="M9 12h6M10 4V2h4v2" stroke="currentColor" stroke-width="1.4"/></svg>
                      {% when 'nomascara' %}
                        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="m6 6 12 12M9 9h6v6H9z" stroke="currentColor" stroke-width="1.3"/></svg>
                      {% else %}
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 14.5 9 21 12l-6.5 3L12 21l-2.5-6L3 12l6.5-3L12 3Z" stroke="currentColor" stroke-width="1.5"/></svg>
                    {% endcase %}
                  </span>
                  <span>{{ block.settings.text }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <div class="pdp-accordions">
            {% for block in section.blocks %}
              {% if block.type == 'accordion' %}
                <div class="pdp-accordion" {{ block.shopify_attributes }}>
                  <button type="button" class="pdp-accordion-toggle" aria-expanded="false">
                    <span>{{ block.settings.title }}</span>
                    <svg viewBox="0 0 18 18" fill="none"><path d="m4 7 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <div class="pdp-accordion-content" hidden>
                    <div class="rte">{{ block.settings.content }}</div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <!-- Témoignages mobile -->
          <div class="pdp-mobile-only pdp-testimonial-wrap">
            {% liquid
  assign testimonial_count = 0
  for block in section.blocks
    if block.type == 'testimonial'
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
%}

{% if testimonial_count > 0 %}
  <div class="pdp-testimonial-slider">
    <div class="pdp-testimonial-card">
      {% assign testimonial_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' %}
          <div
            class="pdp-testimonial{% if testimonial_index == 0 %} is-active{% endif %}"
            data-slide="{{ testimonial_index }}"
            {{ block.shopify_attributes }}
          >
            <div class="pdp-testimonial-head">
              <span class="pdp-testimonial-stars" aria-label="{{ block.settings.stars }} étoiles sur 5">
                {% for i in (1..5) %}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{% endfor %}
              </span>
              <strong>{{ block.settings.name }}</strong>
              {% if block.settings.verified_text != blank %}
                <span>·</span>
                <span class="pdp-verified">{{ block.settings.verified_text }}</span>
              {% endif %}
            </div>
            <p class="pdp-testimonial-text">{{ block.settings.text }}</p>
          </div>
          {% assign testimonial_index = testimonial_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>

    {% if testimonial_count > 1 %}
      <div class="pdp-slider-controls">
        <button type="button" class="pdp-slider-arrow pdp-prev" aria-label="Avis précédent">
          <svg viewBox="0 0 24 24" fill="none"><path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="pdp-dots">
          {% for i in (1..testimonial_count) %}
            <button type="button" class="pdp-dot{% if i == 1 %} is-active{% endif %}" aria-label="Afficher l’avis {{ i }}"></button>
          {% endfor %}
        </div>
        <button type="button" class="pdp-slider-arrow pdp-next" aria-label="Avis suivant">
          <svg viewBox="0 0 24 24" fill="none"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {% endif %}
  </div>
{% endif %}

          </div>

          <!-- Presse mobile -->
          <div class="pdp-mobile-only">
            {% liquid
  assign press_count = 0
  for block in section.blocks
    if block.type == 'press_logo'
      assign press_count = press_count | plus: 1
    endif
  endfor
%}

{% if press_count > 0 %}
  <div class="pdp-press">
    {% if section.settings.press_label != blank %}
      <span class="pdp-press-label">{{ section.settings.press_label }}</span>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == 'press_logo' %}
        <div class="pdp-press-logo" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 220
              | image_tag: loading: 'lazy', alt: block.settings.text
            }}
          {% else %}
            <span>{{ block.settings.text }}</span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

          </div>
        </div>
      </div>
    </div>
  {% endif %}
</section>

{% style %}
  #PDP-{{ section.id }} {
    background: var(--pdp-bg);
    color: var(--pdp-text);
    padding: var(--pdp-pad-y) 0;
    font-family: inherit;
  }

  #PDP-{{ section.id }} * { box-sizing: border-box; }

  #PDP-{{ section.id }} .pdp-shell {
    width: min(calc(100% - 40px), var(--pdp-max));
    margin: 0 auto;
  }

  #PDP-{{ section.id }} .pdp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr);
    gap: var(--pdp-gap);
    align-items: start;
  }

  #PDP-{{ section.id }} .pdp-left,
  #PDP-{{ section.id }} .pdp-right { min-width: 0; }

  /* Gallery */
  #PDP-{{ section.id }} .pdp-gallery {
    display: grid;
